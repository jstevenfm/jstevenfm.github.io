---
import { text } from '../i18n/copy';
import Avatar from './Avatar.astro';
---

<section class="band section contact" id="contacto" aria-labelledby="contact-title">
  <div class="halo halo--mint" style="width: 520px; height: 520px; right: -100px; top: 160px; opacity: var(--halo-mint);"></div>
  <div class="halo halo--lav" style="width: 400px; height: 400px; left: -120px; bottom: 40px; opacity: var(--halo-lav);"></div>
  <div class="wrap contact__panel glass">
    <div class="contact__copy">
      <p class="eyebrow" data-i18n="contactEyebrow">Contacto</p>
      <h2 id="contact-title" data-i18n="contactTitle">¿Hablamos?</h2>
      <p data-i18n="contactBody">{text('es', 'contactBody')}</p>
      <div class="mail-row">
        <a class="btn btn--primary" href="mailto:contacto@jstevenfm.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4 7 8 6 8-6"></path></svg>
          contacto@jstevenfm.com
        </a>
        <button type="button" class="icon-btn" id="copy-mail" aria-label="Copiar correo" data-i18n-attr="aria-label:copyLabel">
          <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="3"></rect><path d="M5 15V6a3 3 0 0 1 3-3h9"></path></svg>
          <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
          <span class="copy-label" data-i18n="copyLabel">Copiar correo</span>
        </button>
      </div>
      <ul class="socials" aria-label="Redes sociales" data-i18n-attr="aria-label:socialLabel">
        <li><a class="btn btn--glass btn--sm" href="https://www.linkedin.com/in/jstevenfm" target="_blank" rel="noopener"><svg viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"></path></svg>LinkedIn</a></li>
        <li><a class="btn btn--glass btn--sm" href="https://github.com/jstevenfm" target="_blank" rel="noopener"><svg viewBox="0 0 1024 1024" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0"></path></svg>GitHub</a></li>
        <li><a class="btn btn--glass btn--sm" href="https://x.com/jstevenfm" target="_blank" rel="noopener"><svg viewBox="0 0 1200 1227" aria-hidden="true" style="width:16px;height:16px"><path fill="currentColor" d="M714.163 519.284 1160.89 0h-105.86L667.137 450.887 357.328 0H0l468.492 681.821L0 1226.37h105.866l409.625-476.152 327.181 476.152H1200L714.137 519.284h.026ZM569.165 687.828l-47.468-67.894-377.686-540.24h162.604l304.797 435.991 47.468 67.894 396.2 566.721H892.476L569.165 687.854v-.026Z"></path></svg>X</a></li>
      </ul>
    </div>
    <div class="contact__avatar">
      <Avatar contact />
    </div>
  </div>
</section>
