---
// 3D avatar stage. The PNG shows first and stays as the fallback when WebGL or the models are unavailable.
import { text } from '../i18n/copy';

interface Props {
  contact?: boolean;
}

const { contact = false } = Astro.props;
---

<div class:list={['avatar', { 'avatar--contact': contact }]} data-avatar>
  <img
    src="/images/avatar-800.webp"
    srcset="/images/avatar-400.webp 400w, /images/avatar-800.webp 800w"
    sizes={contact ? '(max-width: 699px) calc(100vw - 80px), 420px' : '(max-width: 699px) calc(100vw - 32px), (max-width: 1099px) 460px, 540px'}
    alt={text('es', 'avatarAlt')}
    data-i18n-attr="alt:avatarAlt"
    width="800"
    height="800"
    loading={contact ? 'lazy' : 'eager'}
    fetchpriority={contact ? 'auto' : 'high'}
  />
  <slot />
</div>

<script>
  // three.js is large, so it loads once the page is idle instead of blocking the first render.
  const load = () => import('../scripts/avatar').then((m) => m.start()).catch(() => { /* The PNG stays visible. */ });
  if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
  else setTimeout(load, 300);
</script>
