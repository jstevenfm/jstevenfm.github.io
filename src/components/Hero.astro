---
import Avatar from './Avatar.astro';
---

<section class="band hero" aria-labelledby="hero-title">
  <div class="halo halo--mint" style="width: 520px; height: 520px; left: -160px; top: -200px; opacity: var(--halo-mint);"></div>
  <div class="halo halo--lav" style="width: 420px; height: 420px; right: -100px; bottom: 0; opacity: var(--halo-lav);"></div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <span class="status" data-i18n="status">Disponible para proyectos y empleo</span>
      <h1 id="hero-title"><span data-i18n="h1a">Soluciones digitales </span><em data-i18n="h1b">a la medida</em></h1>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="mailto:contacto@jstevenfm.com">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="m4 7 8 6 8-6"></path></svg>
          <span data-i18n="ctaMail">Escríbeme</span>
        </a>
        <button type="button" class="btn btn--glass js-cv">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          <span data-i18n="ctaCv">Descargar CV</span>
        </button>
      </div>
    </div>
    <div class="hero__avatar">
      <Avatar>
        <p class="avatar__pill avatar__pill--a glass" data-i18n="pillA">Full-stack developer</p>
        <p class="avatar__pill avatar__pill--b glass" data-i18n="pillB">IA y automatización</p>
      </Avatar>
    </div>
  </div>
</section>
